# ColdGuard backend — local development (copy to backend/.env). No real secrets here.
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for single-machine development; Docker/K8s use PostgreSQL via DATABASE_URL.
# The original v1 database (coldguard.db) is left untouched; migrate it explicitly with
#   DATABASE_URL=sqlite:///./coldguard.db python scripts/migrate.py
DATABASE_URL=sqlite:///./coldguard_v2.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# REST telemetry gateway key (header X-Ingest-Key). Leave empty to disable key auth.
INGEST_API_KEY=dev-ingest-key-change-me

# Single-process dev: API also runs the scheduler, simulation engine and (optionally) MQTT ingestor
RUN_EMBEDDED_WORKER=true
WORKER_TICK_SECONDS=30
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
REDIS_URL=

DEMO_MODE=true
SIMULATION_ENABLED=true
ML_ENABLED=true
RATE_LIMIT_ENABLED=true
