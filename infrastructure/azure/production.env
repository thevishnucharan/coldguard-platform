# Production Environment Configuration
# Deploys to Azure Kubernetes Service (AKS) with Production resources

ENVIRONMENT=production

# Azure Service Mapping
EVENT_BACKEND=azure
AI_PROVIDER=azure_openai
STORAGE_BACKEND=azure_blob
NOTIFICATION_BACKEND=email

# Azure Resource Configuration
AZURE_EVENT_HUB_NAME=coldguard-events-prod
AZURE_EVENT_HUB_CONSUMER_GROUP=$Default
AZURE_STORAGE_CONTAINER=coldguard-reports-prod
AZURE_OPENAI_ENDPOINT=https://<OPENAI_PROD_RESOURCE_NAME>.openai.azure.com/

# Use placeholders for secrets (Store real values in Azure Key Vault)
AZURE_EVENT_HUB_CONNECTION_STRING=<PROD_EVENT_HUB_CONNECTION_STRING>
AZURE_STORAGE_CONNECTION_STRING=<PROD_STORAGE_CONNECTION_STRING>
AZURE_OPENAI_API_KEY=<PROD_OPENAI_API_KEY>
APPLICATIONINSIGHTS_CONNECTION_STRING=<PROD_APPINSIGHTS_CONNECTION_STRING>
DATABASE_URL=<PROD_DATABASE_URL>
