# Staging Environment Configuration
# Deploys to Azure Kubernetes Service (AKS) with Staging resources

ENVIRONMENT=staging

# Azure Service Mapping
EVENT_BACKEND=azure
AI_PROVIDER=azure_openai
STORAGE_BACKEND=azure_blob
NOTIFICATION_BACKEND=email

# Azure Resource Configuration
AZURE_EVENT_HUB_NAME=coldguard-events-staging
AZURE_EVENT_HUB_CONSUMER_GROUP=$Default
AZURE_STORAGE_CONTAINER=coldguard-reports-staging
AZURE_OPENAI_ENDPOINT=https://<OPENAI_STAGING_RESOURCE_NAME>.openai.azure.com/

# Use placeholders for secrets (Store real values in Azure Key Vault or K8s Secrets)
AZURE_EVENT_HUB_CONNECTION_STRING=<STAGING_EVENT_HUB_CONNECTION_STRING>
AZURE_STORAGE_CONNECTION_STRING=<STAGING_STORAGE_CONNECTION_STRING>
AZURE_OPENAI_API_KEY=<STAGING_OPENAI_API_KEY>
APPLICATIONINSIGHTS_CONNECTION_STRING=<STAGING_APPINSIGHTS_CONNECTION_STRING>
DATABASE_URL=<STAGING_DATABASE_URL>
