# Copy to azure-params.env (git-ignored) or let scripts/ci/azure-deploy.sh write it from
# `terraform output`. These are identifiers, not secrets — every secret stays in Key Vault.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
KEY_VAULT_NAME=kv-coldguardprod-xxxxx
PUBLIC_HOSTNAME=coldguard.example.org
BACKEND_CORS_ORIGINS=https://coldguard.example.org
TLS_CERT_KEYVAULT_URI=https://kv-coldguardprod-xxxxx.vault.azure.net/certificates/coldguard-tls
DEVICES_CIDR=10.40.0.0/16
