# ==============================================================================
# ColdGuard – Local Docker Development Environment
# ==============================================================================
# Copy / rename this file to .env if you need to override compose defaults.
# All values here match the docker-compose.yml defaults so the stack works
# out of the box with:  docker compose up --build
# ==============================================================================

ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=coldguard
POSTGRES_PASSWORD=coldguard_dev_pass
POSTGRES_DB=coldguard_db
DATABASE_URL=postgresql://coldguard:coldguard_dev_pass@postgres:5432/coldguard_db

# Auth / JWT  (generate a real secret for staging/prod with: openssl rand -hex 32)
SECRET_KEY=local_dev_jwt_secret_replace_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_OPEN_ROLE_REGISTRATION=true

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://frontend:5173

# Pluggable Backends (local by default – no cloud credentials needed)
EVENT_BACKEND=local
AI_PROVIDER=mock
STORAGE_BACKEND=local
NOTIFICATION_BACKEND=console

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Simulator
SIMULATOR_EMAIL=simulator@coldguard.com
SIMULATOR_PASSWORD=simulator123

# ==============================================================================
# Azure Cloud Integrations – DISABLED BY DEFAULT
# Uncomment and populate these for production / cloud deployments.
# ==============================================================================
# EVENT_BACKEND=azure
# AZURE_EVENT_HUB_CONNECTION_STRING=
# AZURE_EVENT_HUB_NAME=coldguard-events
# AZURE_EVENT_HUB_CONSUMER_GROUP=$Default

# AI_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# STORAGE_BACKEND=azure_blob
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=coldguard-reports
