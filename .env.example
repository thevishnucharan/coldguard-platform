# ColdGuard v2 — Docker Compose environment. Copy to .env and replace EVERY value.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=development
DEMO_MODE=true                      # false => no demo seed, no simulator, no demo logins

POSTGRES_USER=coldguard
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=coldguard

SECRET_KEY=change-me-to-a-64-char-random-secret-change-me-to-a-64-char-random
INGEST_API_KEY=change-me-ingest-key

MQTT_INGESTOR_PASSWORD=change-me-mqtt-ingestor
MQTT_DEVICE_PASSWORD=change-me-mqtt-device

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Optional MQTT simulator discovery login (demo only; any role with monitoring.view)
SIM_API_EMAIL=auditor@coldguard.local
SIM_API_PASSWORD=

# Production only
PUBLIC_ORIGIN=https://coldguard.example.org

# Host port for the UI (change if 8080 is taken, e.g. by Jenkins)
UI_PORT=8080
